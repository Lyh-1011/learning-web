[Unit]
Description=Publish learning-web static files from GitHub main
Wants=network-online.target
After=network-online.target caddy.service

[Service]
Type=oneshot
User=learning-web-deploy
Group=learning-web-deploy
ExecStart=/usr/bin/python3 /usr/local/libexec/learning-web-publish.py
TimeoutStartSec=150
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/srv/projects/learning-web /srv/www/learning-web /var/lib/learning-web-deploy
